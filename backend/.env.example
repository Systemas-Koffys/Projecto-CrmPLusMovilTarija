# ═══════════════════════════════════════════════════
# BACKEND — Variables de entorno  
# Copiar a backend/.env y llenar valores
# ═══════════════════════════════════════════════════

PORT=3000
NODE_ENV=development

# Supabase (desde supabase.com → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Firebase Admin (desde Firebase Console → Settings → Service Accounts)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# CORS
CORS_ORIGIN=http://localhost:5173

# Chatbot Automático de WhatsApp
CHATBOT_ENABLED=true
