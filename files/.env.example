# ═══════════════════════════════════════════════════════════════════════════════
# CRM RADIO MÓVILES — EJEMPLO DE VARIABLES DE ENTORNO
# 
# INSTRUCCIONES:
# 1. Duplicar este archivo: .env.example → .env (en cada carpeta)
# 2. Llenar los valores con tus credenciales
# 3. NUNCA hacer commit de .env (agregar a .gitignore)
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (.env)
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# SUPABASE
# Obtener desde: https://supabase.com → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# FIREBASE
# Obtener desde: Firebase Console → Settings → Service Accounts
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBA...
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase.iam.gserviceaccount.com

# CORS
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (.env)
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:3000

# FIREBASE CONFIG
# Obtener desde: Firebase Console → Settings → General → Web App
VITE_FIREBASE_API_KEY=AIzaSyC2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-firebase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-firebase
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-firebase.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES POR SECCIÓN
# ─────────────────────────────────────────────────────────────────────────────

# SUPABASE_URL y SUPABASE_ANON_KEY:
# 1. Ir a https://supabase.com
# 2. Crear nuevo proyecto o abrir existente
# 3. Settings → API
# 4. Copiar "Project URL" y "anon public key"

# SUPABASE_SERVICE_KEY:
# 1. Settings → API
# 2. Scroll hasta "Service role key"
# 3. Copiar la clave completa (es larga)

# FIREBASE_PRIVATE_KEY, FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL:
# 1. Firebase Console → tu proyecto
# 2. Settings → Service Accounts
# 3. Click "Generate new private key"
# 4. Se descarga un JSON con todas las credenciales
# 5. Copiar los valores que faltan
# IMPORTANTE: Nunca subir este archivo a git

# FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, etc. (frontend):
# 1. Firebase Console → tu proyecto
# 2. Settings → General
# 3. En "Your apps" → Web app
# 4. Copiar el objeto "firebaseConfig"
# 5. Mapear los valores a las variables VITE_FIREBASE_*

# ─────────────────────────────────────────────────────────────────────────────
# SEGURIDAD
# ─────────────────────────────────────────────────────────────────────────────

# NUNCA hacer esto:
# ❌ Subir .env a GitHub
# ❌ Compartir credenciales por email o chat
# ❌ Commitear serviceAccountKey.json

# SIEMPRE hacer esto:
# ✓ Agregar .env a .gitignore
# ✓ Mantener credenciales en variables de entorno
# ✓ En producción, usar secrets management (GitHub Secrets, Render, etc.)
# ✓ Rotar credenciales periodicamente
